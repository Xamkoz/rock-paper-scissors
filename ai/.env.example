# Web API key + project from Firebase console (same values as Android google-services.json)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Dedicated bot account (enable Email/Password in Firebase Auth)
BOT_EMAIL=bot@example.com
BOT_PASSWORD=
BOT_DISPLAY_NAME=RPS Bot

# Comma-separated queue formats (must overlap with human opponents)
BOT_MATCH_MODES=BO3,BO5
BOT_AUTO_QUEUE=true

# Self-hosted LLM (OpenAI-compatible API — Ollama, vLLM, LocalAI, etc.)
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Smaller models pick faster (e.g. gemma3:4b); 12b often exceeds round clock
LLM_MODEL=gemma3:4b
# Log each LLM call (first 8 lines of each prompt by default)
LLM_LOG_REQUESTS=true
# LLM_LOG_PREVIEW_LINES=8
# LLM_LOG_PREVIEW_LINE_CHARS=160
# LLM_LOG_PROMPT_BODY=true
# LLM_LOG_MAX_CHARS=4000
# LLM_API_KEY=
# LLM_TIMEOUT_MS=60000

# Local SQLite match database (not Firestore)
MATCH_DB_PATH=data/matches.db

# Queue heartbeat while waiting for match (ms). Legacy alias: QUEUE_HEARTBEAT_MS
BOT_QUEUE_INTERVAL_MS=30000

# FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
