# Web API key + project from Firebase console (same values as Android google-services.json)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Dedicated bot account (enable Email/Password in Firebase Auth)
BOT_EMAIL=bot@example.com
BOT_PASSWORD=
BOT_DISPLAY_NAME=RPS Bot

# Comma-separated queue formats (must overlap with human opponents)
BOT_MATCH_MODES=BO3,BO5
BOT_AUTO_QUEUE=true

# Self-hosted LLM (OpenAI-compatible API — Ollama, vLLM, LocalAI, etc.)
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Smaller models pick faster (e.g. gemma3:4b); 12b often exceeds round clock
LLM_MODEL=gemma3:4b
# Up to three models: startup warmup + rank by match win rate & ELO delta (logged as [bot-start:llm-models])
# LLM_MODELS=gemma3:4b,qwen2.5:3b,llama3.2:3b
# Min matches per model before defaulting to top-ranked model (default: fair share = ceil(total/3), min 10)
# LLM_MODEL_MIN_MATCHES=25
# Min pick citations per intel signal before citeHints default to top-ranked signals (fair share, min 5)
# INTEL_SIGNAL_MIN_PICKS=15
# Auto-pull missing models via Ollama /api/pull at startup (default on for :11434). Set false for vLLM-only.
# LLM_AUTO_PULL=true
# Log each LLM call (full system + user prompts by default)
LLM_LOG_REQUESTS=true
# Log raw model reply on [llm:<tag>:res] and [move] llm=… (default on)
LLM_LOG_RESPONSES=true
# LLM_LOG_PROMPT_PREVIEW=true
# LLM_LOG_PREVIEW_LINES=8
# LLM_LOG_PREVIEW_LINE_CHARS=160
# LLM_LOG_MAX_CHARS=4000
# LLM_API_KEY=
# LLM_TIMEOUT_MS=60000
# Speed: deterministic tactics (no extra LLM on round 1). Set true for prose plans from the model.
# LLM_TACTICS_USE_LLM=false
# Move pick: think multiplier (default 1.2 = LLM time + 20% pause), timeout cap, submit reserve
# LLM_PICK_THINK_MULTIPLIER=1.2
# LLM_PICK_TIMEOUT_CAP_MS=30000
# LLM_PICK_MIN_BUDGET_MS=30000
# LLM_PICK_MAX_TOKENS=128
# LLM_TACTICS_BUDGET_MS=30000
# LLM_TACTICS_MAX_TOKENS=128
# LLM_TACTICS_MAX_CHARS=960
# Ollama only: smaller context window = faster (optional)
# LLM_NUM_CTX=4096
# LLM_OPTIONS_JSON={"options":{"num_gpu":99}}
# LLM_PICK_SUBMIT_RESERVE_MS=2500
# Post-game recap length (default ~40-80 words, max 500 chars)
# LLM_DESCRIBE_MAX_TOKENS=96
# LLM_DESCRIBE_MAX_CHARS=240
# LLM_DESCRIBE_MAX_WORDS=36
# LLM_DESCRIBE_MAX_SENTENCES=2

# Local SQLite match database (not Firestore)
MATCH_DB_PATH=data/matches.db

# Intel efficiency: run `npm run rank` for [bot-start:intel-sources] + [bot-start:intel-signals] + LLM tables; per-match lines still append to tactics-intel.log during play
# TACTICS_INTEL_LOG_PATH=data/tactics-intel.log
# TACTICS_INTEL_LOG_PATH=false
# TACTICS_INTEL_LOG_JSON=true

# Session heartbeats: 30s queue doc + presence while queued; 30s presence during match (not configurable).

# Ms to wait after a game before re-joining queue (0 = immediate). Always milliseconds.
BOT_REQUEUE_DELAY_MS=60000

# FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
